{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esun-ai-challenge.tw/schemas/D-Plan.schema.json",
  "title": "D-Plan — 當日 Agent 決策報告及交易書",
  "description": "每台股交易日繳交之 JSON 文件（每日唯一繳交物），包含決策過程和當日委托內容。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "doc_type", "team_id", "trade_date", "sources", "observations", "market_view",
               "inferences", "decisions", "no_trade_decisions", "orders", "agent_metadata"],
  "properties": {
    "_NOTE": {"type": "string", "description": "非正式欄位：範例檔備註用，正式提交可省略"},
    "schema_version": {"type": "string", "pattern": "^4\\.\\d+$", "description": "規格版本，填 4.x（例如 4.3）"},
    "doc_type": {"const": "D-Plan"},
    "team_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$", "description": "隊伍ID，作為識別上傳檔案的隊伍欄位"},
    "trade_date": {"$ref": "#/$defs/date", "description": "「本計劃書所對應之交易日（非繳交日）」"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/source"},
                "description": "L0 資料來源層。列出本份計劃書實際引用的所有資料來源。"},
    "observations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/observation"},
                     "description": "L1 資訊擷取層：只准可核對的事實，禁止推論性語句"},
    "market_view": {"$ref": "#/$defs/market_view",
                    "description": "L2M 整體市場判斷鏈（必填）：市場級依據 → 走向研判 → 風險姿態 → 可驗證的部位含意。系統會檢查宣告與委託總效果的一致性"},
    "inferences": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"$ref": "#/$defs/inference"},
                   "description": "L2 個股推論層：事實 + 策略規則 → 結論"},
    "decisions": {"type": "array", "minItems": 0, "maxItems": 60, "items": {"$ref": "#/$defs/decision"},
                  "description": "L3 決策層（異動）。無交易日可為空陣列，但 no_trade_decisions 仍須完整"},
    "no_trade_decisions": {"type": "array", "minItems": 0, "maxItems": 30, "items": {"$ref": "#/$defs/no_trade_decision"},
                           "description": "L3 決策層（續抱）：每檔未異動持股各一筆，附理由引用。未通過即整份退回"},
    "orders": {"type": "array", "minItems": 0, "maxItems": 60, "items": {"$ref": "#/$defs/order"},
               "description": "L4 委託層。須與《D-Plan 撰寫指南》§⑥ 的推導演算法（輸入為 decisions、資料包的前日結算持股與淨值、交易所前日收盤價）結果一致（比對 ticker / side / shares）"},
    "agent_metadata": {"$ref": "#/$defs/agent_metadata"}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+08:00$",
                  "description": "ISO-8601，一律台北時區 +08:00"},
    "sha256_prefixed": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ticker": {"type": "string", "pattern": "^[0-9]{4}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "authority", "url", "content_as_of"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^S[0-9]{1,3}$", "description": "層內唯一"},
        "authority": {"enum": ["twse", "tpex", "taifex", "mops", "fininst", "media", "vendor", "other"]},
        "url": {"type": "string", "format": "uri"},
        "name": {"type": "string", "maxLength": 300},
        "archive_url": {"type": "string", "format": "uri"},
        "published_at": {"$ref": "#/$defs/timestamp"},
        "content_as_of": {"$ref": "#/$defs/timestamp"},
        "fetched_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["obs_id", "source_ref", "statement", "values"],
      "properties": {
        "obs_id": {"type": "string", "pattern": "^O[0-9]{1,3}$"},
        "source_ref": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^S[0-9]{1,3}$"}},
        "topic": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
        "statement": {"type": "string", "minLength": 5, "maxLength": 500},
        "values": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
      }
    },
    "market_view": {
      "type": "object", "additionalProperties": false,
      "required": ["basis_refs", "logic", "regime", "stance", "posture", "counter_evidence"],
      "properties": {
        "basis_refs": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^O[0-9]{1,3}$"}},
        "logic": {"type": "string", "minLength": 20, "maxLength": 1000},
        "regime": {"enum": ["risk_on", "neutral", "risk_off"]},
        "stance": {"enum": ["aggressive", "neutral", "defensive"]},
        "posture": {
          "type": "object", "additionalProperties": false,
          "required": ["net_exposure_intent", "target_cash_pct_range"],
          "properties": {
            "net_exposure_intent": {"enum": ["increase", "hold", "reduce"]},
            "target_cash_pct_range": {"type": "array", "minItems": 2, "maxItems": 2,
                                      "items": {"type": "number", "minimum": 0, "maximum": 0.25}}
          }
        },
        "counter_evidence": {"type": ["string", "null"], "maxLength": 500},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["inf_id", "premise_refs", "logic", "counter_evidence"],
      "properties": {
        "inf_id": {"type": "string", "pattern": "^I[0-9]{1,3}$"},
        "premise_refs": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^O[0-9]{1,3}$"}},
        "logic": {"type": "string", "minLength": 20, "maxLength": 1000},
        "conclusion": {"type": "string", "maxLength": 300},
        "counter_evidence": {"type": ["string", "null"], "maxLength": 500},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "ticker", "action", "target_weight", "inference_refs"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^D[0-9]{1,3}$"},
        "ticker": {"$ref": "#/$defs/ticker"},
        "action": {"enum": ["BUY", "ADD", "TRIM", "SELL_ALL"]},
        "target_weight": {"type": "number", "minimum": 0, "maximum": 0.25},
        "inference_refs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "pattern": "^I[0-9]{1,3}$"}},
        "risk_check": {"type": "string", "maxLength": 300},
        "funding_for": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
                        "items": {"type": "string", "pattern": "^D[0-9]{1,3}$"}}
      }
    },
    "no_trade_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "reason_refs"],
      "properties": {
        "ticker": {"$ref": "#/$defs/ticker"},
        "reason_refs": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "pattern": "^I[0-9]{1,3}$"}},
        "reason": {"type": "string", "maxLength": 300}
      }
    },
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "side", "shares", "decision_ref"],
      "properties": {
        "ticker": {"$ref": "#/$defs/ticker"},
        "side": {"enum": ["BUY", "SELL"]},
        "shares": {"type": "integer", "minimum": 1000, "multipleOf": 1000},
        "decision_ref": {"type": "string", "pattern": "^D[0-9]{1,3}$"},
        "derivation_detail": {"type": "string", "maxLength": 300}
      }
    },
    "agent_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["model_provider", "model_version", "run_started_at", "run_completed_at", "code_version"],
      "properties": {
        "model_provider": {"enum": ["anthropic", "openai", "google", "xai", "deepseek", "alibaba", "meta", "mistral",
                                     "cohere", "amazon", "microsoft", "nvidia", "taide", "other"]},
        "model_version": {"type": "string", "minLength": 3, "maxLength": 60},
        "run_started_at": {"$ref": "#/$defs/timestamp"},
        "run_completed_at": {"$ref": "#/$defs/timestamp"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "tool_use_count": {"type": "integer", "minimum": 0},
        "code_version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:/\\-]{1,64}$"}
      }
    }
  }
}
